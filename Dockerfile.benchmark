FROM node:22-bookworm-slim AS build

ARG BENCHMARK_WORLD=@tonbo-io/world-ursula
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV WORKFLOW_TARGET_WORLD=${BENCHMARK_WORLD}
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable \
    && corepack prepare pnpm@10.15.1 --activate \
    && pnpm --version

WORKDIR /workspace

ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /rds-ca/global-bundle.pem

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY benchmark/app/package.json benchmark/app/package.json
COPY benchmark/runner/package.json benchmark/runner/package.json

RUN pnpm install --frozen-lockfile
RUN mkdir -p node_modules/@tonbo-io \
    && ln -s ../.. node_modules/@tonbo-io/world-ursula

COPY src src
COPY benchmark benchmark

RUN pnpm build
RUN pnpm --filter workflow-benchmark-app build
RUN pnpm --filter workflow-benchmark-runner typecheck

FROM node:22-bookworm-slim

ARG BENCHMARK_WORLD=@tonbo-io/world-ursula
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV WORKFLOW_TARGET_WORLD=${BENCHMARK_WORLD}

RUN corepack enable \
    && corepack prepare pnpm@10.15.1 --activate \
    && pnpm --version

WORKDIR /workspace
COPY --from=build /workspace /workspace
COPY --from=build /rds-ca/global-bundle.pem /etc/ssl/rds/global-bundle.pem

EXPOSE 3000

CMD ["pnpm", "--filter", "workflow-benchmark-app", "start"]
