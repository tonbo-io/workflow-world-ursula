FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV WORKFLOW_TARGET_WORLD=/workspace/dist/index.js
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY benchmark/app/package.json benchmark/app/package.json
COPY benchmark/runner/package.json benchmark/runner/package.json

RUN pnpm install --frozen-lockfile

COPY src src
COPY benchmark benchmark

RUN pnpm build
RUN pnpm --filter workflow-benchmark-app build
RUN pnpm --filter workflow-benchmark-runner typecheck

FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable

WORKDIR /workspace
COPY --from=build /workspace /workspace

EXPOSE 3000

CMD ["pnpm", "--filter", "workflow-benchmark-app", "start"]
