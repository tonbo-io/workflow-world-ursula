{
  "name": "@tonbo-io/world-ursula",
  "version": "0.1.0",
  "description": "Ursula-backed World implementation for the Workflow SDK",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "DESIGN.md",
    "BENCHMARK.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonbo-io/workflow-world-ursula.git"
  },
  "bugs": {
    "url": "https://github.com/tonbo-io/workflow-world-ursula/issues"
  },
  "homepage": "https://github.com/tonbo-io/workflow-world-ursula#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run src",
    "test:e2e": "vitest run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workflow/errors": "5.0.0-beta.12",
    "@workflow/utils": "5.0.0-beta.6",
    "@workflow/world": "5.0.0-beta.22",
    "ulid": "~3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@workflow/world-testing": "5.0.0-beta.36",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "keywords": [
    "workflow",
    "durable-streams",
    "ursula",
    "queue",
    "streaming"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
