    {
      "name": "step",
      "description": "one trivial no-op step, no stream; no hooks, so the run stays in turbo mode (in-process fast path)"
    },
    {
      "name": "stream",
      "description": "one streaming step; no hooks, so the run stays in turbo mode (in-process fast path)"
    },
    {
      "name": "hook + stream",
      "description": "registers a hook before one step, which exits turbo mode (dispatch path)"
    },
    {
      "name": "1020 steps",
      "description": "1020 trivial sequential steps; STSO is measured between consecutive steps in the given step ranges, and WO is the whole-run overhead outside step bodies"
    },
    {
      "name": "stream latency",
      "description": "parallel reader/writer steps on a dedicated stream; SL is the in-deployment write->read propagation (readAt - writtenAt)"
    },
    {
      "name": "stream overhead (text)",
      "description": "writer streams 300 variable-length text token deltas paced at 100/s for 3s (a haiku-size LLM's token throughput) while a parallel reader drains the whole stream; SO is the end-to-end write+consume time beyond the 3s generation window (overhead/backpressure)"
    },
    {
      "name": "stream overhead (structured)",
      "description": "same workload as stream overhead (text), but each delta is an AI-SDK-style structured object ({ type: 'text-delta', id, text }) instead of a raw string, so the SO gap vs the text scenario is the added serialization cost"
    },
    {
      "name": "retained stream (full)",
      "description": "fresh reader replays all 1000 chunks from a closed retained stream; reports first retained chunk and full drain latency"
    },
    {
      "name": "retained stream (resume)",
      "description": "fresh reader resumes at chunk 900 of a closed 1000-chunk stream; reports first retained chunk and suffix drain latency"
    },
    {
      "name": "100 concurrent x 50 steps",
      "description": "100 workflows execute 50 sequential no-op steps each; reports makespan, per-run TTFS/duration, and aggregate logical step throughput"
    }
  ],
